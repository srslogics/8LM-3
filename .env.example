DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full
APP_ENV=development
PORT=8000
# Production requires HTTPS; Render supplies RENDER_EXTERNAL_URL.
# APP_ORIGIN=https://eightlm-3.onrender.com
# Trust only the actual ingress proxy:
# FORWARDED_ALLOW_IPS=127.0.0.1
DATABASE_POOL_SIZE=5
ENABLE_API_DOCS=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v26
# OAuth callback: https://YOUR_HOST/api/auth/google/callback
# Integration tests require an isolated DB and a non-production marker:
# NEON_BRANCH=python-migration-test
