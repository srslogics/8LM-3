# Copy from the Neon project's production branch. Never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full
# In Render, RENDER_EXTERNAL_URL supplies the origin automatically.
# APP_ORIGIN=https://eightlm-3.onrender.com
# NODE_ENV=production
PORT=8000

# Google Developers API & OAuth 2.0 (Google Ads & Campaign Manager 360)
# One-time setup: configure these in Render to enable 1-Click "Connect with Google" for all users
GOOGLE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_oauth_client_secret

# Google Ads API v18 (Optional for server-to-server manager linking)
GOOGLE_ADS_MANAGER_ID=123-456-7890
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token_here
GOOGLE_ADS_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_oauth_refresh_token
